{
  "pluginName": "nodejs",
  "displayName": "Node.js 运行时环境",
  "version": "0.1.2",
  "apiVersion": "1.0",
  "description": "为 GUI 插件进程与 AI Bash 提供共享的 Node.js LTS 运行时。安装后由 AI 按文档引导下载 Node 到本插件 runtime/ 目录，平台自动将其注册进程序内部 PATH（系统环境变量零改动）。后续插件声明 dependencies: [\"nodejs\"] 即可使用 node。",
  "icon": "package",
  "category": "integration",
  "dependencies": [],
  "installType": "ai-guided",
  "runtimes": [
    {
      "id": "node",
      "path": "runtime"
    }
  ],
  "contributes": {
    "panels": [],
    "commands": [],
    "events": []
  },
  "processes": [],
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "settings": {
    "defaultLtsMajor": {
      "type": "number",
      "title": "默认 LTS 大版本",
      "description": "AI 代装 Node 时优先选择的 LTS 大版本（如 22），0=跟随最新 LTS",
      "default": 0,
      "min": 0,
      "max": 30
    },
    "mirrorPriority": {
      "type": "select",
      "title": "下载镜像优先级",
      "description": "代装 Node 时先试哪个镜像源",
      "default": "npmmirror",
      "options": [
        {
          "value": "npmmirror",
          "label": "npmmirror（国内）"
        },
        {
          "value": "huawei",
          "label": "华为云"
        },
        {
          "value": "official",
          "label": "官方"
        }
      ]
    }
  }
}