{
  "name": "claude-code-ide",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.37",
  "publisher": "claude-code",
  "license": "MIT",
  "repository": "https://github.com/anthropics/claude-code",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "AI",
    "Programming Languages"
  ],
  "keywords": [
    "claude",
    "ai",
    "agent",
    "chat",
    "coding-assistant"
  ],
  "activationEvents": [
    "onCommand:claude-code.startChat",
    "onCommand:claude-code.sendSelection",
    "onCommand:claude-code.sendFile",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-code.startChat",
        "title": "%command.startChat%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claude-code.sendSelection",
        "title": "%command.sendSelection%"
      },
      {
        "command": "claude-code.sendFile",
        "title": "%command.sendFile%"
      },
      {
        "command": "claude-code.explainCode",
        "title": "%command.explainCode%"
      },
      {
        "command": "claude-code.addToChat",
        "title": "%command.addToChat%"
      }
    ],
    "keybindings": [
      {
        "command": "claude-code.sendSelection",
        "key": "alt+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "claude-code.explainCode",
          "group": "claude-code",
          "when": "editorHasSelection"
        },
        {
          "command": "claude-code.sendSelection",
          "group": "claude-code",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "claude-code.addToChat",
          "group": "claude-code"
        }
      ],
      "commandPalette": [
        {
          "command": "claude-code.startChat",
          "when": "true"
        },
        {
          "command": "claude-code.sendSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "claude-code.sendFile",
          "when": "editorIsOpen"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-code-chat",
          "title": "%viewContainer.title%",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "claude-code-chat": [
        {
          "id": "claude-code.chatView",
          "name": "%view.name%",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "claudeCode.cliPath": {
          "type": "string",
          "default": "",
          "description": "%config.cliPath.description%"
        },
        "claudeCode.autoSendContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoSendContext.description%"
        },
        "claudeCode.maxFilesInContext": {
          "type": "number",
          "default": 5,
          "description": "%config.maxFilesInContext.description%"
        },
        "claudeCode.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "description": "%config.language.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4"
  }
}
