# ═══════════════════════════════════════════════════════════════════
# CLAUDE CODE — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
#
# This file contains SYSTEM-level environment variables (timeouts,
# telemetry, TUI behavior). API credentials and model selection are
# managed via `claude-profile` or directly in ~/.claude/settings.json.
#
# ── Timeouts & Limits ────────────────────────────────────────────
#   API_TIMEOUT_MS                    — API request timeout in ms (default: 600000)
#   MAX_TOKENS                        — Maximum tokens per response
#   CLAUDE_CODE_MAX_OUTPUT_TOKENS     — Output token limit override
#   CLAUDE_CODE_MAX_CONTEXT_TOKENS    — Context window size override
#
# ── Telemetry & Network ──────────────────────────────────────────
#   DISABLE_TELEMETRY=1               — Disable all telemetry
#   CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 — Disable non-critical requests
#
# ── TUI Behavior ─────────────────────────────────────────────────
#   CLAUDE_CODE_VIRTUAL_SCROLL_THRESHOLD — Lines before virtual scroll kicks in
#   CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1 — Disable non-streaming fallback
#
# ── API Configuration (use claude-profile instead) ───────────────
#   ANTHROPIC_AUTH_TOKEN   →  ~/.claude/settings.json  via `claude-profile switch`
#   ANTHROPIC_BASE_URL     →  ~/.claude/settings.json  via `claude-profile switch`
#   ANTHROPIC_MODEL etc.   →  ~/.claude/settings.json  via `claude-profile switch`
# ═══════════════════════════════════════════════════════════════════

API_TIMEOUT_MS=1200000
MAX_TOKENS=384000
CLAUDE_CODE_MAX_OUTPUT_TOKENS=384000
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1
CLAUDE_CODE_VIRTUAL_SCROLL_THRESHOLD=999999
